<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>SteamWorkshopUnsub</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyTitle>SteamWorkshopUnsub</AssemblyTitle>
    <AssemblyDescription>CLI tool for listing and unsubscribing from Steam Workshop items.</AssemblyDescription>
    <Company>I love Mahou Shoujo Lyrical Nanoha</Company>
    <Copyright>Brasileiro</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <SteamworksRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</SteamworksRuntimeIdentifier>
    <SteamworksRuntimeIdentifier Condition="'$(SteamworksRuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</SteamworksRuntimeIdentifier>
    <SteamworksRuntimeIdentifier Condition="'$(SteamworksRuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</SteamworksRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(SteamworksRuntimeIdentifier)' == 'win-x64'">
    <Reference Include="Steamworks.NET">
      <HintPath>../deps/Steamworks.NET/win-x64/Steamworks.NET.dll</HintPath>
    </Reference>
    <!-- Native Steamworks libraries must remain beside the executable for direct loading. -->
    <None Include="../deps/Steamworks.NET/win-x64/steam_api64.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(SteamworksRuntimeIdentifier)' == 'linux-x64'">
    <Reference Include="Steamworks.NET">
      <HintPath>../deps/Steamworks.NET/linux-x64/Steamworks.NET.dll</HintPath>
    </Reference>
    <!-- Native Steamworks libraries must remain beside the executable for direct loading. -->
    <None Include="../deps/Steamworks.NET/linux-x64/libsteam_api.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../THIRD_PARTY_NOTICES.md"
          Link="THIRD_PARTY_NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateSteamworksRuntimeIdentifier" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(SteamworksRuntimeIdentifier)' != 'win-x64' And '$(SteamworksRuntimeIdentifier)' != 'linux-x64'">
    <Error Text="Steamworks.NET does not support the target runtime '$(SteamworksRuntimeIdentifier)' in this project. Supported runtimes: linux-x64 and win-x64." />
  </Target>
</Project>
